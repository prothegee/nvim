            "    <meta charset=\"utf-8\">",
            "    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">",
            "    <title>${2:REPLACE_THE_TITLE}</title>",
            "</head>",
            "<body>",
            "    <!-- ??? -->",
            "</body>",
            "</html>",
            ""
        ]
    }
}

