    "generate generic random signed number": {
        "prefix": "gen generic random signed number",
        "body": [
            "type SignedNumber interface {",
            "    ~int8|~int16|~int|~int32|~int64",
            "}",
            "",
            "// @brief generate random signed number",
            "//",
            "// @note safe for seed concurrency",
            "// @note if minRange larger than maxRange, it will be swapp",
            "//",
            "// @param r *rand.Rand - from new random, e.g. `rand.New(rand.NewSource(time.Now().UnixNano()))`",
            "// @param minRange int - min range",
            "// @param maxRange int - max range",
            "//",
            "// @return T SignedNumber",
            "func RandomSignedNumber[T SignedNumber](r *rand.Rand, minRange, maxRange T) T {",
            "    if minRange > maxRange {",
            "        // force swap number if minRange larger",
            "        minRange, maxRange = maxRange, minRange",
            "    }",
            "",
            "    minval := int64(minRange)",
            "    maxVal := int64(maxRange)",
            "",
            "    // safeguard even after swap and return minRange instead",
            "    if minVal > maxVal {",
            "        return minRange",
            "    }",
            "    return T(minVal+r.Int63n(maxVal-minVal+1))",
            "}"
        ]
    },
