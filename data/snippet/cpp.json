{
	"comment spacer": {
		"prefix": "comment spacer",
		"body": [
			"// --------------------------------------------------------- //"
		]
	},
    "for loop": {
        "prefix": "for loop",
        "body": [
            "for (${1:int} ${2:i} = ${3:0}; ${2:i} < ${4:10}; ${2:i}++) {",
            "    // todo",
            "}"
        ]
    },
    "try catch": {
        "prefix": "try catch",
        "body": [
            "try {",
            "    // try",
            "} catch (...) {",
            "    // catch",
            "}"
        ]
    },
    "try catch exception": {
        "prefix": "try catch exception",
        "body": [
            "try {",
            "    // try",
            "} catch (const std::exception &e) {",
            "    // catch e",
            "}"
        ]
    },
    "try catch exception finally": {
        "prefix": "try catch exception finally",
        "body": [
            "try {",
            "    // try",
            "} catch (const std::exception &e) {",
            "    // catch e",
            "} catch (...) {",
            "    // catch f",
            "}"
        ]
    },
    "struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Struct_s} {",
            "    // data",
            "}; // ${1:Struct_s}"
        ]
    },
    "struct typedef 1": {
        "prefix": "struct typedef 1",
        "body": [
            "typedef struct {",
            "    // data",
            "} ${1:Struct_typedef_1};"
        ]
    },
	"struct typedef 2": {
        "prefix": "struct typedef 2",
        "body": [
            "typedef struct ${1:_Struct_typedef_2} {",
            "    // data",
            "} ${2:Struct_typedef_2};"
        ]
    },
	"class": {
		"prefix": "class",
		"body": [
			"class ${1:Class_c} {",
            "    // data",
			"public:",
			"    ${1:Class_c}() = default;",
			"    ~${1:Class_c}() = default;",
            "}; // ${1:Class_c}"
		]
	},
	"namespace": {
		"prefix": "namespace",
		"body": [
			"namespace ${1:ns_what} {",
			"",
			"// TODO",
			"",
			"} // namespace ${1:ns_what}"
		]
	},
	"if not define define": {
		"prefix": "ifndef def endif",
		"body": [
			"#ifndef ${1:REPLACE_ME}",
			"#define ${1:REPLACE_ME}",
			"#endif // ${1:REPLACE_ME}"
		]
	},
	"int main": {
		"prefix": "int main",
		"body": [
			"int main() {",
            "    // todo",
            "    return 0;",
            "}"
		]
	},
	"int main argc argv": {
		"prefix": "int main argc argv",
		"body": [
			"int main(int argc, char *argv[]) {",
            "    // todo",
            "    return 0;",
            "}"
		]
	},
	"head guard": {
		"prefix": "head guard",
		"body": [
			"#ifndef ${1:REPLACE_ME}",
			"#define ${1:REPLACE_ME}",
			"#endif // ${1:REPLACE_ME}"
		]
	},
	"head file info": {
		"prefix": "head file info",
		"body": [
			"// ### file: $TM_FILENAME",
            "// ",
            "// ### author: ${1:FULL_NAME}",
            "// ",
            "// ---------------------------------------------------------",
            "// ",
            "// ### brief:",
            "// n/a",
            "// ",
            "// ### note:",
            "// n/a",
            "// ",
            "// ---------------------------------------------------------",
            "// ",
            "// ### copyright:",
            "// ",
            "// - (c) ${2:YYYYMMDD} ${3:HOLDER} // ${4:USERNAME} // ${5:EMAIL}",
            "// ",
            "// ### contributors:",
            "// ",
            "// - ${3:HOLDER} // ${4:USERNAME} // ${5:EMAIL}",
            "//"
		]
	}
}

