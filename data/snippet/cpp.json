{
	"comment spacer": {
		"prefix": "_comment_spacer",
		"body": [
			"// --------------------------------------------------------- //"
		]
	},
    "for loop i": {
        "prefix": "_for_loop_i",
        "body": [
            "for (${1:int} ${2:i} = ${3:0}; ${2:i} < ${4:10}; ${2:i}++) {",
            "    // todo",
            "}"
        ]
    },
    "try catch": {
        "prefix": "_try_catch",
        "body": [
            "try {",
            "    // try",
            "} catch (...) {",
            "    // catch",
            "}"
        ]
    },
    "try catch exception": {
        "prefix": "_try_catch_exception",
        "body": [
            "try {",
            "    // try",
            "} catch (const std::exception &e) {",
            "    // catch e",
            "}"
        ]
    },
    "try catch exception finally": {
        "prefix": "_try_catch_exception_finally",
        "body": [
            "try {",
            "    // try",
            "} catch (const std::exception &e) {",
            "    // catch e",
            "} catch (...) {",
            "    // catch f",
            "}"
        ]
    },
    "struct": {
        "prefix": "_struct",
        "body": [
            "struct ${1:Struct_s} {",
            "    // data",
            "}; // ${1:Struct_s}"
        ]
    },
    "struct typedef 1": {
        "prefix": "_struct_typedef_1",
        "body": [
            "typedef struct {",
            "    // data",
            "} ${1:Struct_typedef_1};"
        ]
    },
	"struct typedef 2": {
        "prefix": "_struct_typedef_2",
        "body": [
            "typedef struct ${1:_Struct_typedef_2} {",
            "    // data",
            "} ${2:Struct_typedef_2};"
        ]
    },
	"class": {
		"prefix": "_class",
		"body": [
			"class ${1:Class_c} {",
            "    // data",
			"public:",
			"    ${1:Class_c}() = default;",
			"    ~${1:Class_c}() = default;",
            "}; // ${1:Class_c}"
		]
	},
	"namespace": {
		"prefix": "_namespace",
		"body": [
			"namespace ${1:ns_what} {",
			"",
			"// TODO",
			"",
			"} // namespace ${1:ns_what}"
		]
	},
	"if not define define": {
		"prefix": "_ifndef_def_endif",
		"body": [
			"#ifndef ${1:REPLACE_ME}",
			"#define ${1:REPLACE_ME}",
			"#endif // ${1:REPLACE_ME}"
		]
	},
	"int main": {
		"prefix": "_int_main",
		"body": [
			"int main() {",
            "    return 0;",
            "}"
		]
	},
	"int main argc argv": {
		"prefix": "_int_main_argc_argv",
		"body": [
			"int main(int argc, char *argv[]) {",
            "    return 0;",
            "}"
		]
	},
	"head file info": {
		"prefix": "_head_file_info",
		"body": [
			"/// ### file: $TM_FILENAME_BASE",
            "/// ",
            "/// ### author: ${1:FULL_NAME}",
            "/// ",
            "/// ---------------------------------------------------------",
            "/// ",
            "/// ### brief:",
            "/// n/a",
            "/// ",
            "/// ### note:",
            "/// n/a",
            "/// ",
            "/// ---------------------------------------------------------",
            "/// ",
            "/// ### copyright:",
            "/// ",
            "/// - (c) ${2:YYYYMMDD} ${3:HOLDER} // ${4:USERNAME} // ${5:EMAIL}",
            "/// ",
            "/// ### contributors:",
            "/// ",
            "/// - ${3:HOLDER} // ${4:USERNAME} // ${5:EMAIL}",
            "///"
		]
	}
}

