{
    "comment spacer": {
		"prefix": "comment spacer",
		"body": [
			"// --------------------------------------------------------- //"
		]
	},
    "allocator smp": {
        "prefix": "allocator smp",
        "body": [
            "var ${1:allocator} = std.heap.smp_allocator;"
        ]
    },
    "allocator page": {
        "prefix": "allocator page",
        "body": [
            "var ${1:allocator} = std.heap.page_allocator;"
        ]
    },
    "allocator test": {
        "prefix": "allocator test",
        "body": [
            "var ${1:allocator} = std.testing.allocator;"
        ]
    },
    "allocator arena 1": {
        "prefix": "allocator arena",
        "body": [
            "var ${1:allocator} = std.heap.ArenaAllocator.init(std.heap.smp_allocator);",
            "defer ${1:allocator}.deinit();"
        ]
    },
    "allocator arena 2": {
        "prefix": "allocator arena 2",
        "body": [
            "var ${1:allocator}: std.heap.ArenaAllocator = .init(std.heap.smp_allocator);",
            "defer ${1:allocator}.deinit();"
        ]
    },
    "const import": {
        "prefix": "const import",
        "body": [
            "const ${1:var} = @import(\"${2:who}\")"
        ]
    },
    "log debug": {
        "prefix": "log debug",
        "body": [
            "std.log.debug(\"${1}\\n\", .{${2}});"
        ]
    },
    "log info": {
        "prefix": "log info",
        "body": [
            "std.log.info(\"${1}\\n\", .{${2}});"
        ]
    },
    "log warn": {
        "prefix": "log warn",
        "body": [
            "std.log.warn(\"${1}\\n\", .{${2}});"
        ]
    },
    "log error": {
        "prefix": "log error",
        "body": [
            "std.log.err(\"${1}\\n\", .{${2}});"
        ]
    },
    "debug print": {
        "prefix": "debug print",
        "body": [
            "std.debug.print(\"${1}\\n\", .{${2}});"
        ]
    },
    "const import std": {
        "prefix": "const import std",
        "body": [
            "const std = @import(\"std\");"
        ]
    },
    "for loop i": {
		"prefix": "for loop i",
		"body": [
			"for (${1:0}..${2:10}) |${3:i}| {",
            "    // do something with `${3:i}`",
            "}"
		]
	},
    "for loop vars": {
		"prefix": "for loop vars",
		"body": [
			"for (${1:vars}) |${2:var}| {",
            "    // do something with `${2:var}`",
            "}"
		]
	},
    "while loop": {
		"prefix": "while loop",
		"body": [
			"while (${1:true}) {",
            "    // do something",
            "}"
		]
	},
    "while loop vars": {
		"prefix": "while loop vars",
		"body": [
			"while (${1:vars}) |${2:var}| {",
            "    // do something with `${2:var}`",
            "}"
		]
	},
    "enum": {
		"prefix": "enum",
		"body": [
			"const ${1:EnumName} = enum {",
            "    // tbd",
            "};"
		]
	},
    "enum size": {
		"prefix": "enum size",
		"body": [
			"const ${1:EnumName} = enum(${2:u8}) {",
            "    // tbd",
            "};"
		]
	},
    "struct": {
		"prefix": "struct",
		"body": [
			"const ${1:Name} = struct {",
            "    // tba",
            "};"
		]
	},
    "main init pub void": {
        "prefix": "main init pub void",
        "body": [
            "pub fn main() !void {",
            "    // TODO",
            "}"
        ]
    },
    "main init pub void process": {
        "prefix": "main init pub void process",
        "body": [
            "pub fn main(process: std.process.Init) !void {",
            "    // TODO",
            "}"
        ]
    },
    "main init pub void init": {
        "prefix": "main init pub void init",
        "body": [
            "pub fn main(init: std.process.Init) !void {",
            "    // TODO",
            "}"
        ]
    },
    "test define": {
        "prefix": "test define",
        "body": [
            "test \"${1:label}: ${2:description}\" {",
            "    ${3:// TODO}",
            "}"
        ]
    },
    "test expect bool": {
        "prefix": "test expect bool",
        "body": [
            "// false will fail",
            "try std.testing.expect(${1:false});"
        ]
    },
    "test expect equal": {
        "prefix": "test expect equal",
        "body": [
            "try std.testing.expectEqual(@as(${1:T}, ${2:expected}), ${3:actual});"
        ]
    },
    "test expect equal string": {
        "prefix": "test expect equal string",
        "body": [
            "try std.testing.expectEqualStrings(\"${1:expected}\", ${2:actual});"
        ]
    },
    "head file info": {
		"prefix": "head file info",
		"body": [
			"// ### file: $TM_FILENAME",
            "// ",
            "// ### author: ${1:FULL_NAME}",
            "// ",
            "// ---------------------------------------------------------",
            "// ",
            "// ### brief:",
            "// n/a",
            "// ",
            "// ### note:",
            "// n/a",
            "// ",
            "// ---------------------------------------------------------",
            "// ",
            "// ### copyright:",
            "// ",
            "// - (c) ${2:YYYYMMDD} ${3:HOLDER} // ${4:USERNAME} // ${5:EMAIL}",
            "// ",
