{
    "comment spacer": {
		"prefix": "comment spacer",
		"body": [
			"// --------------------------------------------------------- //"
		]
	},
    "allocator arena": {
        "prefix": "allocator arena",
        "body": [
            "var arena = std.heap.ArenaAllocator.init(std.heap.smp_allocator);",
            "defer arena.deinit();"
        ]
    },
    "const import": {
        "prefix": "const import",
        "body": [
            "const ${1:var} = @import(\"${2:who}\")"
        ]
    },
    "for loop i": {
		"prefix": "for loop i",
		"body": [
			"for (${1:0}..${2:10}) |${3:i}| {",
            "    // do something with `${3:i}`",
            "}"
		]
	},
    "for loop vars": {
		"prefix": "for loop vars",
		"body": [
